{
  "name": "blueprint",
  "version": "0.1.0",
  "private": true,
  "description": "Blueprint OpenCode plugin and MCP workflow engine",
  "type": "module",
  "exports": {
    ".": "./dist/opencode/plugin.js",
    "./server": "./dist/opencode/plugin.js"
  },
  "bin": {
    "blueprint-opencode": "./dist/opencode/lifecycle-cli.js"
  },
  "blueprint": {
    "stateCompatibility": "blueprint-state-v1"
  },
  "files": [
    "agents",
    "commands",
    "dist",
    "generated/command-catalog.json",
    "generated/opencode-assets.json",
    "skills"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=moderate",
    "generate:commands": "tsx scripts/generate-command-registry.ts",
    "generate:opencode-assets": "tsx scripts/generate-opencode-assets.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:focused": "tsx --test",
    "test:integration:opencode": "npm run build --silent && node --import tsx --test tests/opencode-package.test.ts tests/opencode-registration.integration.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ajv": "^8.20.0",
    "yaml": "^2.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.34",
    "@types/node": "^25.6.0",
    "esbuild": "^0.28.0",
    "testcontainers": "^11.14.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
