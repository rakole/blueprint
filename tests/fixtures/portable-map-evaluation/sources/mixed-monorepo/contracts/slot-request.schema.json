{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MarketRoute pickup slot request",
  "type": "object",
  "required": ["requestId", "memberId", "depotCode", "boxCount", "routeDate"],
  "properties": {
    "requestId": {"type": "string", "minLength": 1},
    "memberId": {"type": "string", "minLength": 1},
    "depotCode": {"type": "string", "minLength": 1},
    "boxCount": {"type": "integer", "minimum": 1, "maximum": 12},
    "routeDate": {"type": "string", "format": "date"}
  },
  "additionalProperties": false
}
