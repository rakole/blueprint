{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blueprint.phase.research.model",
  "title": "Blueprint Phase Research Model",
  "description": "A small evidence-linked research core with optional prose. MCP owns identity, saved constraints, rendering and persistence. Submission saves the candidate before readiness assessment.",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "findings", "recommendations", "sources"],
  "properties": {
    "summary": { "$ref": "#/$defs/prose" },
    "findings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/finding" } },
    "recommendations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/recommendation" } },
    "openQuestions": { "type": "array", "default": [], "items": { "$ref": "#/$defs/question" } },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "description": "Include only topics that matter to the implementation decision. Each value is Markdown prose or a list of prose paragraphs. Omission means no section-specific detail was supplied, not that an investigation proved none exists.",
      "properties": {
        "standardStack": { "$ref": "#/$defs/section" },
        "installationAndSetup": { "$ref": "#/$defs/section" },
        "alternativesConsidered": { "$ref": "#/$defs/section" },
        "architecturePatterns": { "$ref": "#/$defs/section" },
        "dontHandRoll": { "$ref": "#/$defs/section" },
        "antiPatterns": { "$ref": "#/$defs/section" },
        "stateOfTheArt": { "$ref": "#/$defs/section" },
        "commonPitfalls": { "$ref": "#/$defs/section" },
        "codeExamples": { "$ref": "#/$defs/section" }
      }
    }
  },
  "$defs": {
    "prose": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "line": { "type": "string", "minLength": 1, "pattern": "^(?=.*\\S)[^\\r\\n]+$" },
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,79}$" },
    "ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "section": { "anyOf": [{ "$ref": "#/$defs/prose" }, { "type": "array", "items": { "$ref": "#/$defs/prose" } }] },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "finding", "sourceIds", "confidence", "requirementIds", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "finding": { "$ref": "#/$defs/prose" },
        "sourceIds": { "$ref": "#/$defs/ids" },
        "confidence": { "enum": ["LOW", "MEDIUM", "HIGH"] },
        "requirementIds": { "$ref": "#/$defs/ids" },
        "status": { "enum": ["supported", "inferred", "unsupported"] }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "recommendation", "findingIds", "affectedSurfaces", "verification", "requirementIds", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "recommendation": { "$ref": "#/$defs/prose" },
        "findingIds": { "$ref": "#/$defs/ids" },
        "affectedSurfaces": { "type": "array", "items": { "$ref": "#/$defs/line" } },
        "verification": { "type": "array", "items": { "$ref": "#/$defs/prose" } },
        "requirementIds": { "$ref": "#/$defs/ids" },
        "status": { "enum": ["ready", "blocked"] }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "blocking"],
      "properties": { "question": { "$ref": "#/$defs/prose" }, "blocking": { "type": "boolean" } }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "lane", "reference"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "lane": { "enum": ["repo", "external", "supplied"] },
        "reference": { "$ref": "#/$defs/line" },
        "title": { "$ref": "#/$defs/line" },
        "accessed": { "$ref": "#/$defs/line" },
        "excerpt": { "$ref": "#/$defs/prose" },
        "limitations": { "$ref": "#/$defs/prose" }
      }
    }
  }
}
