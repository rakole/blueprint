{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blueprint.phase.context.model",
  "title": "Blueprint Phase Context Model",
  "description": "Model-authored payload for phase.context. Runtime-owned phase identity, artifact kind, paths, canonical filename, and final Markdown persistence are supplied by MCP tools.",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "phaseBoundary": {
      "$ref": "#/$defs/phaseBoundary",
      "description": "Content rendered under Phase Boundary."
    },
    "discoveryGrounding": {
      "$ref": "#/$defs/discoveryGrounding",
      "description": "Content rendered under Discovery Grounding."
    },
    "implementationDecisions": {
      "type": [
        "array",
        "null"
      ],
      "description": "Decision rows rendered under Implementation Decisions.",
      "items": {
        "$ref": "#/$defs/implementationDecision"
      },
      "default": []
    },
    "specificIdeas": {
      "type": [
        "array",
        "null"
      ],
      "description": "Concrete ideas rendered under Specific Ideas.",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "default": []
    },
    "existingCodeInsights": {
      "type": [
        "array",
        "null"
      ],
      "description": "Concrete codebase observations, reusable patterns, gaps, or cautions rendered under Existing Code Insights.",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "default": []
    },
    "dependencies": {
      "$ref": "#/$defs/dependencies",
      "description": "Dependency context rendered under Dependencies."
    },
    "openQuestions": {
      "type": [
        "array",
        "null"
      ],
      "description": "Open questions rendered under Open Questions. Use an empty array when no open questions remain; omitted/null lists and complete aliases such as [\"none\"] are accepted and render as - none.",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "default": []
    },
    "deferredIdeas": {
      "type": [
        "array",
        "null"
      ],
      "description": "Deferred ideas, scope creep, or later follow-ups rendered under Deferred Ideas. Use an empty array only when nothing is deferred; MCP renders the canonical - none sentinel.",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "default": []
    },
    "canonicalReferences": {
      "type": [
        "array",
        "null"
      ],
      "description": "Evidence pointers rendered under Canonical References.",
      "items": {
        "$ref": "#/$defs/canonicalReference"
      },
      "default": []
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$",
      "description": "Non-empty text. Multiline prose is safely rendered by MCP."
    },
    "repoOrSourceReference": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$",
      "description": "Non-empty text. Multiline prose is safely rendered by MCP."
    },
    "phaseBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "goal": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "inScope": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "default": []
        },
        "outOfScope": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "default": []
        },
        "successCriteria": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "default": []
        }
      }
    },
    "discoveryGrounding": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "projectBrief": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "requirementsGrounding": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "default": []
        },
        "workflowPosture": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "confirmedDecisions": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "default": []
        }
      }
    },
    "implementationDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision"
      ],
      "properties": {
        "decision": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "tradeoffOrConstraint": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "priorPhaseArtifacts": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/repoOrSourceReference"
          },
          "default": []
        },
        "externalConstraints": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "default": []
        },
        "requiredFollowUpReads": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/repoOrSourceReference"
          },
          "default": []
        }
      }
    },
    "canonicalReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/repoOrSourceReference"
        },
        "relevance": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    }
  }
}
